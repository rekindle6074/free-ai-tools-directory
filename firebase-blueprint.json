{
  "entities": {
    "Tool": {
      "title": "AI Tool",
      "description": "A curated free AI tool.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the tool" },
        "description": { "type": "string", "description": "Short description" },
        "url": { "type": "string", "format": "uri", "description": "Link to the tool" },
        "category": { "type": "string", "description": "Category ID" },
        "isFree": { "type": "boolean", "description": "Whether it's completely free" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Search tags" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "description", "url", "category"]
    },
    "Category": {
      "title": "Tool Category",
      "description": "A category for AI tools.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name" },
        "icon": { "type": "string", "description": "Lucide icon name" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User Profile",
      "description": "User preferences and favorites.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "favorites": { "type": "array", "items": { "type": "string" }, "description": "List of favorite tool IDs" }
      },
      "required": ["uid", "email"]
    },
    "Folder": {
      "title": "Custom Folder",
      "description": "A user-created custom folder to organize favorite tools.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the folder" },
        "toolIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of tools contained inside this folder" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the folder was created" }
      },
      "required": ["name", "toolIds"]
    },
    "Favorite": {
      "title": "User Favorite",
      "description": "A tool favorited by a user with an optional note.",
      "type": "object",
      "properties": {
        "toolId": { "type": "string", "description": "ID of the favorited tool" },
        "note": { "type": "string", "description": "Personal note about the tool" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was favorited" }
      },
      "required": ["toolId"]
    },
    "SharedFolder": {
      "title": "Shared Folder",
      "description": "A publicly shared custom folder with a collection of favorite tools.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the shared folder" },
        "toolIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of tools included in this share" },
        "creatorUid": { "type": "string", "description": "UID of the creator" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["name", "toolIds", "creatorUid"]
    }
  },
  "firestore": {
    "/tools/{toolId}": {
      "schema": "Tool",
      "description": "Collection of AI tools"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of tool categories"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/users/{userId}/favorites/{toolId}": {
      "schema": "Favorite",
      "description": "User's favorited tools with notes"
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": "Folder",
      "description": "User's custom folders to organize favorites"
    },
    "/shared_folders/{shareId}": {
      "schema": "SharedFolder",
      "description": "Publicly shared folders with favorite tools"
    },
    "/stats/{statId}": {
      "schema": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" }
        }
      },
      "description": "Global statistics"
    }
  }
}
